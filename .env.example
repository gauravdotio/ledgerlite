# Copy this file to .env and fill in real values. Never commit .env.
# Only DATABASE_URL and AUTH_SECRET are required; everything else switches
# on an optional feature.

# ── Database (required) ──────────────────────────────────────────────
# Neon → your project → Connect. Use the POOLED string (host contains
# "-pooler") here, and the DIRECT string (no "-pooler") for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth (required) ──────────────────────────────────────────────────
# Signs session cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Optional "Continue with Google". Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID (Web). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google   (and your Vercel URL)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI (optional) ────────────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey. Turns on receipt
# reading and the Ask page. Without it you type receipt details yourself.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Any Gemini model id. The default alias tracks Google's current Flash model.
# AI_MODEL="gemini-flash-latest"

# ── Receipt storage (required on Vercel, optional locally) ───────────
# Vercel → Storage → Create Blob store → connect to this project; Vercel
# adds this for you. Locally, without it, images go to ./.local/uploads.
BLOB_READ_WRITE_TOKEN=""
